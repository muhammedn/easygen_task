NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/easygen
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
# Defaults to true when NODE_ENV=production, false otherwise. Set explicitly for Docker http.
COOKIE_SECURE=false
# Enable when the API sits behind a reverse proxy (nginx) so rate limits use the real client IP.
TRUST_PROXY=false
